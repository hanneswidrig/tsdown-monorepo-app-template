{
  "name": "tsdown-monorepo-app-template",
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "up": "pnpm up -r --latest --interactive",
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsgo",
    "prepublishOnly": "pnpm run build",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "@typescript/native-preview": "catalog:",
    "oxfmt": "catalog:oxc",
    "oxlint": "catalog:oxc",
    "oxlint-tsgolint": "catalog:oxc",
    "tsdown": "catalog:"
  },
  "packageManager": "pnpm@11.5.1"
}
